/* Models linked into this build of the runtime (cmake -DCPV_MODELS=...).
 * Generated by CMake from runtime/src/models.c.in. */
#include "cpvehicle/cpvehicle_model.h"

#include <string.h>

@CPV_REGISTRY_DECLARATIONS@
static const cpv_model_t *const models[] = {
@CPV_REGISTRY_ENTRIES@  NULL,
};

size_t cpv_model_count(void) { return sizeof(models) / sizeof(models[0]) - 1; }

const cpv_model_t *cpv_model_at(size_t index) {
  return index < cpv_model_count() ? models[index] : NULL;
}

const cpv_model_t *cpv_find_model(const char *name) {
  for (size_t i = 0; name && i < cpv_model_count(); i++)
    if (strcmp(models[i]->name, name) == 0)
      return models[i];
  return NULL;
}
