From 01eeeb3c55bdbe1ab33791a48778bdb6aa6672a6 Mon Sep 17 00:00:00 2001
From: Arslan8 <arslankhan52@gmail.com>
Date: Fri, 6 Nov 2026 13:49:03 -0500
Subject: [PATCH 3/3] SITL: cpvehicle runs vehicle models linked into the
 binary

--model cpvehicle:NAME now opens a CP Models vehicle model compiled into
libcpvehicle (prepare --shim NAME, cmake -DCPV_MODELS=...) with
cpv_open_model, instead of reading a descriptor file and dlopening the
FMU's shared library. Nothing is loaded at run time; an unknown NAME stops
SITL with the list of linked models.

Flown again with the linked quad (guided), rover and plane (AUTO); results
match the descriptor runs.
---
 Tools/ardupilotwaf/boards.py                |  5 +--
 libraries/SITL/SIM_CPVehicle.cpp            | 21 ++++++++---
 libraries/SITL/SIM_CPVehicle.h              | 15 ++++----
 libraries/SITL/examples/CPVehicle/README.md | 40 +++++++++++++--------
 wscript                                     |  2 +-
 5 files changed, 55 insertions(+), 28 deletions(-)

diff --git a/Tools/ardupilotwaf/boards.py b/Tools/ardupilotwaf/boards.py
index b1838760d2..782dfe5533 100644
--- a/Tools/ardupilotwaf/boards.py
+++ b/Tools/ardupilotwaf/boards.py
@@ -813,10 +813,11 @@ class sitl(Board):
             env.CXXFLAGS += ['-DWITH_SITL_RGBLED']
 
         if cfg.options.cpvehicle:
-            # CP Models vehicle runtime: in-process FMU physics (SIM_CPVehicle).
+            # CP Models vehicle runtime with its linked vehicle models
+            # (cmake -DCPV_MODELS=...): in-process FMU physics (SIM_CPVehicle).
             root = os.path.abspath(os.path.expanduser(cfg.options.cpvehicle))
             library = os.path.join(root, 'build', 'runtime-release', 'libcpvehicle.a')
-            header = os.path.join(root, 'runtime', 'include', 'cpvehicle', 'cpvehicle.h')
+            header = os.path.join(root, 'runtime', 'include', 'cpvehicle', 'cpvehicle_model.h')
             for required in (library, header):
                 if not os.path.isfile(required):
                     cfg.fatal('--cpvehicle: %s not found' % required)
diff --git a/libraries/SITL/SIM_CPVehicle.cpp b/libraries/SITL/SIM_CPVehicle.cpp
index 6b4e1cb1a7..9686f2f7b5 100644
--- a/libraries/SITL/SIM_CPVehicle.cpp
+++ b/libraries/SITL/SIM_CPVehicle.cpp
@@ -40,9 +40,22 @@ const char *const required_capabilities[] = {
 CPVehicle::CPVehicle(const char *frame_str) :
     Aircraft(frame_str)
 {
+    // The models linked into libcpvehicle (cmake -DCPV_MODELS=...).
+    char linked[256] = "";
+    for (size_t i = 0; i < cpv_model_count(); i++) {
+        const size_t used = strlen(linked);
+        snprintf(linked + used, sizeof(linked) - used, "%s%s", i ? ", " : "",
+                 cpv_model_at(i)->name);
+    }
     const char *colon = strchr(frame_str, ':');
     if (colon == nullptr || colon[1] == '\0') {
-        AP_HAL::panic("cpvehicle: use --model cpvehicle:/path/to/vehicle.json");
+        AP_HAL::panic("cpvehicle: use --model cpvehicle:NAME; linked models: %s",
+                      linked[0] ? linked : "none (build libcpvehicle with -DCPV_MODELS)");
+    }
+    const cpv_model_t *model = cpv_find_model(colon + 1);
+    if (model == nullptr) {
+        AP_HAL::panic("cpvehicle: no linked model '%s'; linked models: %s", colon + 1,
+                      linked[0] ? linked : "none (build libcpvehicle with -DCPV_MODELS)");
     }
     cpv_options_t options;
     cpv_options_init(&options);
@@ -50,7 +63,7 @@ CPVehicle::CPVehicle(const char *frame_str) :
     options.required_count = ARRAY_SIZE(required_capabilities);
     options.instance_name = "ardupilot-sitl";
     char error[1024];
-    const cpv_status_t status = cpv_open(colon + 1, &options, &vehicle, error, sizeof(error));
+    const cpv_status_t status = cpv_open_model(model, &options, &vehicle, error, sizeof(error));
     if (status != CPV_OK) {
         AP_HAL::panic("cpvehicle: cannot open %s: %s: %s", colon + 1,
                       cpv_status_string(status), error);
@@ -84,8 +97,8 @@ CPVehicle::CPVehicle(const char *frame_str) :
                           unsigned(element), unsigned(channel_count));
         }
     }
-    ::printf("cpvehicle: %s, %u PWM channel(s), profile %s\n", cpv_model_name(vehicle),
-             unsigned(channel_count), cpv_profile(vehicle));
+    ::printf("cpvehicle: %s (%s, linked), %u PWM channel(s), profile %s\n", model->name,
+             cpv_model_name(vehicle), unsigned(channel_count), cpv_profile(vehicle));
     for (size_t i = 0; i < channel_count; i++) {
         double start_us = 0;
         cpv_pwm_start(vehicle, i, &start_us);
