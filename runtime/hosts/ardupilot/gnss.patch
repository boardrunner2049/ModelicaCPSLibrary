+// Framing only: completed requests are interpreted by the Modelica receiver.
+bool GPS_UBlox::parse_config_byte(uint8_t byte)
+{
+    switch (parse_state) {
+    case 0:
+        if (byte==0xb5) { parse_state=1; }
+        return false;
+    case 1:
+        parse_state=byte==0x62 ? 2 : byte==0xb5 ? 1 : 0;
+        checksum_a=checksum_b=0;
+        return false;
+    case 2: case 3: case 4: case 5:
+        header[parse_state-2]=byte;
+        if (++parse_state==6) {
+            payload_length=uint16_t(header[2]) | (uint16_t(header[3])<<8);
+            payload_offset=0;
+            if (payload_length==0) { parse_state=7; }
+        }
+        break;
+    case 6:
+        if (payload_offset < sizeof(payload)) { payload[payload_offset]=byte; }
+        if (++payload_offset==payload_length) { parse_state=7; }
+        break;
+    case 7:
+        parse_state=byte==checksum_a ? 8 : byte==0xb5 ? 1 : 0;
+        return false;
+    case 8:
+        parse_state=0;
+        if (byte==checksum_b) { return true; }
+        if (byte==0xb5) { parse_state=1; }
+        return false;
+    }
+    checksum_b += (checksum_a += byte);
+    return false;
+}
