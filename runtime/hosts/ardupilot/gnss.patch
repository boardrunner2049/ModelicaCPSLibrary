+void GPS_UBlox::submit_config()
+{
+    double *request=_sitl->gps_ubx_command;
+    if (request[0]>=INT32_MAX) { AP_HAL::panic("GNSS UBX command identifier exhausted"); }
+    pending_request=uint32_t(request[0])+1;
+    memset(request, 0, sizeof(_sitl->gps_ubx_command));
+    request[0]=pending_request;
+    request[1]=header[0];
+    request[2]=header[1];
+    request[3]=payload_length==0 ? 0 : 2;
+    if (header[0]==6 && header[1]==0x24 && payload_length==sizeof(Nav5)) {
+        Nav5 nav;
+        memcpy(&nav, payload, sizeof(nav));
+        request[3]=1;
+        request[4]=nav.mask;
+        request[5]=nav.dynamic_model;
+        request[6]=nav.fix_mode;
+        request[7]=nav.fixed_alt*0.01;
+        request[8]=nav.fixed_alt_variance*0.0001;
+        request[9]=nav.min_elevation;
+        request[10]=double(nav.pdop)/10;
+        request[11]=nav.tdop*0.1;
+        request[12]=nav.position_accuracy;
+        request[13]=nav.time_accuracy;
+        request[14]=double(nav.static_speed)/100;
+        request[15]=nav.dgnss_timeout;
+        request[16]=nav.cno_count;
+        request[17]=nav.cno;
+        request[18]=nav.static_distance;
+        request[19]=nav.utc;
+    }
+}
