+void GPS_UBlox::update_read()
+{
+    if (!_sitl->state.model_sensors.gps.ubx.present || instance!=0) {
+        GPS_Backend::update_read();
+        return;
+    }
+    if (pending_request!=0) {
+        const double *response=_sitl->state.model_sensors.gps.ubx.response;
+        if (uint32_t(response[0])!=pending_request) { return; }
+        if (uint8_t(response[3])==4) {
+            ::printf("GNSS UBX configuration coverage gap: class=%u id=%u\n",
+                     unsigned(header[0]), unsigned(header[1]));
+        } else {
+            if (uint8_t(response[3])!=1 && uint8_t(response[3])!=2) {
+                AP_HAL::panic("Invalid GNSS UBX configuration response");
+            }
+            if (uint8_t(response[3])==1 && !readback_sent && header[0]==10 && header[1]==4) {
+                struct {
+                    char software[30], hardware[10], extension[3][30];
+                } version {};
+                static_assert(sizeof(version)==130, "MON-VER payload");
+                const unsigned major=uint8_t(response[5]), minor=uint8_t(response[6]);
+                snprintf(version.software, sizeof(version.software), "EXT CORE %u.%02u (emulated)", major, minor);
+                snprintf(version.hardware, sizeof(version.hardware), "%08u", uint32_t(response[4])%100000000U);
+                snprintf(version.extension[0], sizeof(version.extension[0]), "FWVER=SPG %u.%02u", major, minor);
+                snprintf(version.extension[1], sizeof(version.extension[1]), "PROTVER=%u.%02u", unsigned(uint8_t(response[7])), unsigned(uint8_t(response[8])));
+                snprintf(version.extension[2], sizeof(version.extension[2]), "MOD=NEO-M%uN", unsigned(uint8_t(response[9])));
+                if (!send_ubx(4, (const uint8_t*)&version, sizeof(version), 10)) { return; }
+                readback_sent=true;
+            }
+            if (uint8_t(response[3])==1 && !readback_sent && header[0]==6 && header[1]==0) {
+                struct PACKED {
+                    uint8_t port_id, reserved0;
+                    uint16_t tx_ready;
+                    uint32_t mode, baud;
+                    uint16_t input_protocols, output_protocols, flags, reserved1;
+                } port {};
+                static_assert(sizeof(port)==20, "CFG-PRT UART payload");
+                port.port_id=uint8_t(response[4]);
+                port.tx_ready=uint16_t(response[5]);
+                port.mode=uint32_t(response[6]);
+                port.baud=uint32_t(response[7]);
+                port.input_protocols=uint16_t(response[8]);
+                port.output_protocols=uint16_t(response[9]);
+                port.flags=uint16_t(response[10]);
+                if (!send_ubx(0, (const uint8_t*)&port, sizeof(port), 6)) { return; }
+                readback_sent=true;
+            }
+            if (uint8_t(response[3])==1 && !readback_sent && header[0]==6 && header[1]==0x24) {
+                Nav5 nav {};
+                nav.mask=uint16_t(response[4]);
+                nav.dynamic_model=uint8_t(response[5]);
+                nav.fix_mode=uint8_t(response[6]);
+                nav.fixed_alt=int32_t(lround(response[7]*100));
+                nav.fixed_alt_variance=uint32_t(lround(response[8]*10000));
+                nav.min_elevation=int8_t(response[9]);
+                nav.pdop=uint16_t(lround(response[10]*10));
+                nav.tdop=uint16_t(lround(response[11]*10));
+                nav.position_accuracy=uint16_t(response[12]);
+                nav.time_accuracy=uint16_t(response[13]);
+                nav.static_speed=uint8_t(lround(response[14]*100));
+                nav.dgnss_timeout=uint8_t(response[15]);
+                nav.cno_count=uint8_t(response[16]);
+                nav.cno=uint8_t(response[17]);
+                nav.static_distance=uint16_t(response[18]);
+                nav.utc=uint8_t(response[19]);
+                if (!send_ubx(0x24, (const uint8_t*)&nav, sizeof(nav), 6)) { return; }
+                readback_sent=true;
+            }
+            if (uint8_t(response[3])==1 && !readback_sent) {
+                AP_HAL::panic("Unsupported GNSS UBX poll response");
