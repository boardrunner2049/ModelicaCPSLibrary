+    Vector3d vision_position_ned;       // m from home
+    Vector3f vision_velocity_ned;
+    Quaternion vision_attitude;         // body FRD to NED
+    bool beacon_present, beacon_valid;
+    Location beacon_location;           // of the tag
+    bool precland_present, precland_valid;
+    Vector3f precland_los_body;         // unit line of sight to the target, body FRD
+    float precland_distance_m;
+    bool ahrs_present, ahrs_valid;
+    struct {
+        double latitude, longitude, altitude;
+        double speedN, speedE, speedD;
+        double xAccel, yAccel, zAccel;   // m/s/s, body
