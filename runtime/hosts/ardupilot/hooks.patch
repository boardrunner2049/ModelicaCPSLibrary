+// Sensor readings a vehicle model computes itself (SIM_CPVehicle). When
+// valid, the SITL GPS and barometer report them instead of simulating them
+// from the vehicle's truth.
+struct sitl_model_sensors {
+    bool gps_valid;
+    double gps_latitude, gps_longitude; // degrees
+    double gps_altitude;                // m, as sitl_fdm::altitude
+    Vector3f gps_velocity_ned;          // m/s
+    bool baro_valid;
+    float baro_pressure_pa;
+    float baro_temperature_c;
+    // Peripherals (Systems.Peripherals): "present" when the model has the
+    // device, so SITL's own simulation of it is replaced; "valid" per reading.
+    bool airspeed_present;
+    float airspeed_pressure_pa;         // differential, sensor 1
+    bool flow_present, flow_valid;
+    Vector2f flow_rate, flow_body_rate; // rad/s, sensor x/y
+    bool temperature_present;
+    float temperature_c;
+    bool vision_present, vision_valid;
