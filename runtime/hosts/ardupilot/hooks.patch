+// The FDM as an external AHRS/INS simulator reports it: the vehicle model's
+// own AHRS solution (SIM_CPVehicle) when the model has one, else the truth.
+static inline sitl_fdm external_ahrs_view(const sitl_fdm &state)
+{
+    sitl_fdm fdm = state;
+    const auto &model = state.model_sensors;
+    if (model.ahrs_present) {
+        const auto &a = model.ahrs;
+        fdm.latitude = a.latitude;
+        fdm.longitude = a.longitude;
+        fdm.altitude = a.altitude;
+        fdm.speedN = a.speedN;
+        fdm.speedE = a.speedE;
+        fdm.speedD = a.speedD;
+        fdm.xAccel = a.xAccel;
+        fdm.yAccel = a.yAccel;
+        fdm.zAccel = a.zAccel;
+        fdm.rollRate = a.rollRate;
+        fdm.pitchRate = a.pitchRate;
+        fdm.yawRate = a.yawRate;
+        fdm.rollDeg = a.rollDeg;
+        fdm.pitchDeg = a.pitchDeg;
+        fdm.yawDeg = a.yawDeg;
+        fdm.quaternion = a.quaternion;
+    }
+    return fdm;
+}
