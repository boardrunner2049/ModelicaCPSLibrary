diff --git a/Tools/ardupilotwaf/boards.py b/Tools/ardupilotwaf/boards.py
index b1a54e45e3..782dfe5533 100644
--- a/Tools/ardupilotwaf/boards.py
+++ b/Tools/ardupilotwaf/boards.py
@@ -812,6 +812,21 @@ class sitl(Board):
         if cfg.options.sitl_rgbled:
             env.CXXFLAGS += ['-DWITH_SITL_RGBLED']
 
+        if cfg.options.cpvehicle:
+            # CP Models vehicle runtime with its linked vehicle models
+            # (cmake -DCPV_MODELS=...): in-process FMU physics (SIM_CPVehicle).
+            root = os.path.abspath(os.path.expanduser(cfg.options.cpvehicle))
+            library = os.path.join(root, 'build', 'runtime-release', 'libcpvehicle.a')
+            header = os.path.join(root, 'runtime', 'include', 'cpvehicle', 'cpvehicle_model.h')
+            for required in (library, header):
+                if not os.path.isfile(required):
+                    cfg.fatal('--cpvehicle: %s not found' % required)
+            env.INCLUDES += [os.path.join(root, 'runtime', 'include')]
+            env.CXXFLAGS += ['-DAP_SIM_CPVEHICLE_ENABLED=1']
+            # LDFLAGS end the link line, after the vehicle's library archives
+            # that reference the runtime (SIM_CPVehicle is in them).
+            env.LDFLAGS += [library, '-ldl']
+
         if cfg.options.enable_sfml_audio:
             if not cfg.check_SFML_Audio(env):
                 cfg.fatal("Failed to find SFML Audio libraries")
