within ModelicaCPSLibrary.Physical.Sensors.MEMS;
record GyroParameters "Illustrative translational two-mode gyro, NOT a vendor calibration"
  parameter Real mass(unit="kg")=2.5e-9;
  parameter Real driveFrequency(unit="Hz")=1000;
  parameter Real senseFrequency(unit="Hz")=1500;
  parameter Real referenceFrequency(unit="Hz")=driveFrequency "Nominal electrical calibration; does not track truth";
  parameter Real driveQ=30;
  parameter Real senseQ=20;
  parameter Real driveAmplitude(unit="m")=2e-7;
  parameter Real crossStiffness(unit="N/m")=0;
  parameter Real driveC0(unit="F")=1e-14;
  parameter Real driveLength(unit="m")=5e-6 "Comb overlap scale";
  parameter Real biasVoltage(unit="V")=2;
  parameter Real maxDriveVoltage(unit="V")=1;
  parameter Real readC0(unit="F")=1e-14;
  parameter Real readLength(unit="m")=5e-6;
  parameter Real carrierVoltage(unit="V")=1;
  parameter Real feedbackCapacitance(unit="F")=1e-13;
  parameter Real afeTau(unit="s")=1e-5;
  parameter Real rail(unit="V")=3.3;
  parameter Real detectorTau(unit="s")=0.003 "Two-pole drive I/Q detector";
  parameter Real senseTau(unit="s")=0.003 "Two-pole demodulation LPF";
  parameter Real agcKp=0.5;
  parameter Real agcKi(unit="1/s")=20;
  parameter Real pllKp(unit="1/s")=40;
  parameter Real pllKi(unit="1/s2")=400;
  parameter Real pllRange=0.15 "Fraction of reference frequency";
  parameter Real startupFraction=1 "Initially running oscillator; use e.g. 0.1 for startup";
  parameter Real demodPhaseError(unit="rad")=0;
end GyroParameters;
