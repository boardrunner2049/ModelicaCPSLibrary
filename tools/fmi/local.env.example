# Copy to local.env (untracked) and adjust. Read by harness.mk (as make
# variables) and tools/fire_compile.py; environment variables of the same name
# take precedence. Use absolute paths.

# Directory holding Modelica/, ModelicaServices/ and Complex.mo (MSL 4.x). Required.
MODELICA_LIBS ?= /path/to/msl
# Checkout of the world runtime (built under build/, with a venv/ for its Python tools).
WORLD_ROOT ?= /path/to/world
# Rumoca binary. Default: tools/fmi/bin/rumoca if present, else `rumoca` on PATH.
# RUMOCA ?= /path/to/rumoca
